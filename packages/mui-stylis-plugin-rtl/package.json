{
  "name": "@mui/stylis-plugin-rtl",
  "version": "10.0.0-alpha.0",
  "author": "MUI Team",
  "description": "A plugin for Material UI that provides RTL (right-to-left) support.",
  "license": "MIT",
  "keywords": [
    "react",
    "react-component",
    "mui",
    "rtl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mui/material-ui.git",
    "directory": "packages/mui-stylis-plugin-rtl"
  },
  "bugs": {
    "url": "https://github.com/mui/material-ui/issues"
  },
  "homepage": "https://github.com/mui/material-ui/tree/master/packages/mui-utils",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/mui-org"
  },
  "scripts": {
    "build": "code-infra build --tsgo --flat",
    "release": "pnpm build && pnpm publish",
    "test": "pnpm --workspace-root test:unit --project \"*:@mui/stylis-plugin-rtl\"",
    "typescript": "tsc -p tsconfig.json",
    "attw": "attw --pack ./build"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7 || ^8.0.5",
    "cssjanus": "^2.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/stylis": "4.2.7",
    "stylis": "4.4.0"
  },
  "peerDependencies": {
    "stylis": "4.x"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "directory": "build"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
