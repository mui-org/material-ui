{
  "name": "@mui/internal-api-docs-builder",
  "version": "2.0.0",
  "author": "MUI Team",
  "description": "Generates the API docs for MUI packages. This is an internal package not meant for general use.",
  "license": "MIT",
  "scripts": {
    "test": "pnpm --workspace-root test:unit --project \"*:@mui/internal-api-docs-builder\"",
    "typescript": "tsc -p tsconfig.json",
    "build": "code-infra build --tsgo --flat --skipBabelRuntimeCheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mui/material-ui.git",
    "directory": "packages-internal/api-docs-builder"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/traverse": "^7.29.10",
    "@babel/types": "^7.29.8",
    "@mui/internal-docs-utils": "workspace:^",
    "@mui/internal-markdown": "workspace:^",
    "@typescript/typescript6": "^6.0.2",
    "doctrine": "^3.0.0",
    "es-toolkit": "^1.52.0",
    "fast-glob": "^3.3.3",
    "prettier": "^3.9.10",
    "react-docgen": "^8.0.4",
    "recast": "^0.24.0",
    "remark": "^15.0.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/babel__core": "7.20.5",
    "@types/babel__traverse": "7.28.0",
    "@types/doctrine": "0.0.9",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.5",
    "@types/sinon": "22.0.2",
    "sinon": "22.1.0"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "directory": "build"
  },
  "engines": {
    "node": ">=22.23.4"
  }
}
